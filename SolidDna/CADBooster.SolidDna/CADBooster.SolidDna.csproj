<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>3.3.0.0</Version>
    <AssemblyVersion>3.3.0.0</AssemblyVersion>
    <FileVersion>3.3.0.0</FileVersion>
    <Authors>Luke Malpass, Peter Brinkhuis</Authors>
    <Company>CAD Booster B.V.</Company>
    <Description>The new SolidDNA SDK, making the SolidWorks API easier, well behaved and modern</Description>
    <Copyright>Copyright © 2016-2024</Copyright>
    <PackageProjectUrl>https://github.com/CAD-Booster/solidworks-api</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CAD-Booster/solidworks-api</RepositoryUrl>
    <PackageTags>soliddna solidworks cadbooster angelsix api</PackageTags>
    <Product>CADBooster.SolidDna</Product>
    <PackageId>CADBooster.SolidDna</PackageId>
    <AssemblyName>CADBooster.SolidDna</AssemblyName>
    <RootNamespace>CADBooster.SolidDna</RootNamespace>
    <PackageLicenseFile>license.txt</PackageLicenseFile>
    <PackageReleaseNotes>Added support for SOLIDWORKS 2025.
Split SolidAddIn object and added PartnerProductAddIn so add-ins that are not partner products are not blocked in SW Connected. 
Added basic support for opening from and saving to 3DExperience.
Added getting a feature by its name from a Component.
Added inner exception info to SolidDnaException ToString.</PackageReleaseNotes>
    <SignAssembly>true</SignAssembly>
    <PackageIcon>icon.png</PackageIcon>
    <PackageIconUrl />
    <AssemblyOriginatorKeyFile>StrongNameKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile></DocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>bin\Release\net48\CADBooster.SolidDna.xml</DocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Localization\Strings\Strings-en-US.xml" />
    <None Include="icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="license.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\Strings\Strings-en-US.xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Net.Http" />
    <PackageReference Include="UnitsNet" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

    <PropertyGroup>
        <SolidWorksVersion>2023</SolidWorksVersion>
        <SolidWorksReferencePath>..\..\References\$(SolidWorksVersion)</SolidWorksReferencePath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="SolidWorks.Interop.sldworks" HintPath="$(SolidWorksReferencePath)\SolidWorks.Interop.sldworks.dll" EmbedInteropTypes="False" />
        <Reference Include="SolidWorks.Interop.sw3dprinter" HintPath="$(SolidWorksReferencePath)\SolidWorks.Interop.sw3dprinter.dll" EmbedInteropTypes="False" />
        <Reference Include="SolidWorks.Interop.swcommands" HintPath="$(SolidWorksReferencePath)\SolidWorks.Interop.swcommands.dll" EmbedInteropTypes="False" />
        <Reference Include="SolidWorks.Interop.swconst" HintPath="$(SolidWorksReferencePath)\SolidWorks.Interop.swconst.dll" EmbedInteropTypes="False" />
        <Reference Include="SolidWorks.Interop.swdimxpert" HintPath="$(SolidWorksReferencePath)\SolidWorks.Interop.swdimxpert.dll" EmbedInteropTypes="False" />
        <Reference Include="SolidWorks.Interop.swdocumentmgr" HintPath="$(SolidWorksReferencePath)\SolidWorks.Interop.swdocumentmgr.dll" EmbedInteropTypes="False" />
        <Reference Include="SolidWorks.Interop.swmotionstudy" HintPath="$(SolidWorksReferencePath)\SolidWorks.Interop.swmotionstudy.dll" EmbedInteropTypes="False" />
        <Reference Include="SolidWorks.Interop.swpublished" HintPath="$(SolidWorksReferencePath)\SolidWorks.Interop.swpublished.dll" EmbedInteropTypes="False" />
        <Reference Include="SolidWorks.Interop.SWRoutingLib" HintPath="$(SolidWorksReferencePath)\SolidWorks.Interop.SWRoutingLib.dll" EmbedInteropTypes="False" />
    </ItemGroup>
</Project>
